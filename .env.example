# Lilin settings. `node setup.js` creates .env from this file and fills in what it can detect.
# Every setting is optional: a feature whose settings are blank is switched off.
# Restart Lilin after changing anything. Full reference: docs/configuration.md

# ---- Server ----
PORT=8080
# 0.0.0.0 = reachable from your home network. 127.0.0.1 = this computer only (behind a local proxy or tunnel).
HOST=0.0.0.0
# LAN address TVs stream from. Detected automatically; set it only if the address printed at startup is wrong.
SERVER_IP=
# Public address for share links and link previews, e.g. https://lilin.example.com.
PUBLIC_URL=
# Where the database and state files live. Blank = the Lilin folder. To move an existing
# installation, stop Lilin and run: node setup.js migrate-data --to <folder>
DATA_DIR=
# Copies Lilin can always make again (browser copies, previews, share copies); can grow to hundreds
# of GB. Blank = cache in DATA_DIR. To move it, stop Lilin and move the folder's contents.
CACHE_DIR=
# A second copy of the web app (another public/ folder, absolute path) to try a redesign on this server.
# Open /preview to switch this browser to it and /preview/off to go back. Same API, sign-in and permissions.
PREVIEW_DIR=

# ---- Accounts and remote access (docs/remote-access.md) ----
# Owners, as they sign in (Lilin's own sign-in or Cloudflare Access); comma-separated, the first
# is the owner. Create Lilin sign-ins on the server with: node setup.js user add EMAIL [--owner]
ADMIN_EMAILS=
# Visitors directly on the home network (LAN, Tailscale): "shared" lets them in as one shared Home
# network account without signing in; "signin" makes everyone sign in. Visitors from the internet
# always have to sign in, whatever this says.
HOME_NETWORK_ACCESS=shared
# How long a Lilin sign-in lasts without being used, in days (renewed while in use, at most a year).
SESSION_DAYS=30
# Extra host names Lilin answers to, comma-separated (*.example.com works). IP addresses,
# localhost, single-label names and home-network names (.local, .lan, .home.arpa, .ts.net) and
# PUBLIC_URL's host always work; others are refused to stop DNS-rebinding attacks.
ALLOWED_HOSTS=
# Proxies whose identity headers (Cf-Access-Authenticated-User-Email, Cf-Connecting-IP) are trusted.
# Addresses or CIDR ranges. The default trusts this machine only, e.g. cloudflared running here.
TRUSTED_PROXIES=127.0.0.1,::1
# Verify Cloudflare Access tokens instead of trusting a proxy's headers (recommended when cloudflared
# runs on another machine or container). Team domain, e.g. myteam.cloudflareaccess.com, and the
# application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ---- Metadata (themoviedb.org > Settings > API) ----
# "API Read Access Token". TMDB_API_KEY (the short v3 key) works too.
TMDB_TOKEN=
TMDB_API_KEY=
TMDB_LANG=en-US

# ---- Library ----
MEDIA_DIR=

# ---- qBittorrent Web UI ----
# e.g. http://localhost:8081
QBIT_URL=
QBIT_USER=
QBIT_PASS=
# Remove finished downloads from qBittorrent (files kept) so nothing seeds. Tag a torrent "seed" to keep it.
QBIT_REMOVE_FINISHED=on
# Keep unfinished downloads on a faster drive (e.g. an SSD) while the library is on a hard disk, so
# torrents' scattered writes don't stall playback. Conversions write their temporary copy there too.
# Only what fits goes there; qBittorrent moves each finished download to the library. Empty = off.
SCRATCH_DIR=
# Space on that drive that is never used for this, in GB.
SCRATCH_RESERVE_GB=40
# Conversions' temporary copies go to SCRATCH_DIR\convert, or to this folder (e.g. on a second SSD).
CONVERT_SCRATCH_DIR=
# Space on the CONVERT_SCRATCH_DIR drive that is never used for this, in GB (when it's another drive).
CONVERT_SCRATCH_RESERVE_GB=40

# ---- Torrent search ----
TORRENTS=off
# Adult-content filter for search and downloads: on (everyone), members (everyone but the owner) or off.
CONTENT_FILTER=on
# Extra words or phrases to block, comma-separated.
CONTENT_FILTER_WORDS=
TPB_API=https://apibay.org
# 1337x mirrors, comma-separated, tried in order. Blank = the built-in list.
X1337_URL=
# For when every 1337x mirror is behind a Cloudflare check, e.g. http://localhost:8191
FLARESOLVERR_URL=
# Nyaa, for anime (fansub releases and batches). Blank = https://nyaa.si; off = don't search it.
NYAA_URL=
# Knaben, an index over many torrent sites; the best at Swedish and documentary releases. Blank = its public API; off = don't search it.
KNABEN_URL=
# SVT Play (Swedish public service TV): free documentaries and true crime, saved to the library. Works from Sweden only. off = leave it out.
SVT_PLAY=
# AniList's API, used to match anime seasons and names with TMDB's. Blank = https://graphql.anilist.co
ANILIST_URL=

# ---- Subtitles (opensubtitles.com > Profile > API consumers) ----
OPENSUBTITLES_API_KEY=
# Optional account: raises the daily download limit.
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
SUB_LANGS=en,sv,da,no,fi,de,nl,fr,es,pt-pt,pt-br,it,pl,ar,tr,ka,tl
# Fix the timing of downloaded subtitles automatically (needs ffmpeg).
SUBSYNC=on
# Fix OCR mistakes in English subtitles as they're served (names, acronyms, I/l mix-ups).
SUBTITLE_FIX=on

# ---- Casting ----
# DLNA description URLs for TVs that aren't discovered automatically, comma-separated.
DLNA_DEVICES=
# Apple TV support needs pyatv (pipx install pyatv).
CAST_APPLETV=on
# Full path to atvscript if it isn't on PATH.
ATVSCRIPT=
# Apple TV addresses to query directly if discovery fails, comma-separated.
ATV_HOSTS=
# Offer TVs to visitors who aren't at home too.
CAST_WHEN_AWAY=off
# Folder with the Android TV app (Lilin.apk + Lilin.json from tv/android/build.sh), offered at /android at home.
# Empty: tv/android/dist.
ANDROID_APP_DIR=

# ---- Playback first (docs/configuration.md#playback-first) ----
# Read streams in pieces this large (KB). Large reads keep a busy hard drive from stalling players.
STREAM_READ_KB=4096
# CPU priority of Lilin itself, and of its background jobs (conversions, previews, copies, OCR).
LILIN_PRIORITY=above_normal
BACKGROUND_PRIORITY=below_normal
# Windows: I/O + memory priority of background jobs (normal, low, very_low).
BACKGROUND_IO=normal
# on = qBittorrent uses its alternative speed limits while anyone is streaming.
QBIT_PLAYBACK_LIMITS=on
# Seconds after the last stream before downloads go back to full speed.
PLAYBACK_IDLE_SECONDS=60

# ---- Conversion (needs ffmpeg) ----
CONVERT=on
# Delete originals after conversion. Never applies to files qBittorrent owns. Subtitle tracks are
# kept in <name>.subtitles.mks first (MP4 can't hold Blu-ray/DVD image subtitles).
CONVERT_DELETE_ORIGINAL=off
# HEVC files added within this many days get an H.264 copy for browsers without HEVC right after
# downloading. Older files get one when first played. 0 = off.
BROWSER_H264_DAYS=14
# Browser copies prepared ahead for the next episodes when one needs it. 0 = off.
PREPARE_NEXT_EPISODES=2
# Phone-quality streams (live 1080p/720p for big files on phones) that may run at once; more stops the oldest.
PHONE_STREAMS_MAX=3
# Play now: watch a video while it's still downloading (a live stream of up to 1080p). off = finished files only.
PARTIAL_STREAMS=on
# Full paths, only if ffmpeg/ffprobe aren't on PATH.
FFMPEG=
FFPROBE=
# Where browser copies (audio-fixed and H.264) are kept. Blank = audio in CACHE_DIR.
AUDIO_FIX_DIR=
# Size cap for browser copies in GB; the ones watched longest ago make room first. 0 = no cap.
BROWSER_COPIES_MAX_GB=150
# GB conversions leave free on every drive they write to (they wait otherwise). 0 = off.
MIN_FREE_GB=20

# ---- Download to phone ----
# Small copies (480p/720p MP4) people make to watch offline. Blank = travel in CACHE_DIR.
TRAVEL_DIR=
# A copy is deleted this many days after it was last asked for or downloaded.
TRAVEL_KEEP_DAYS=7
# The folder's size cap in GB. Copies everyone already downloaded make room first.
TRAVEL_MAX_GB=50

# ---- Notes (owners only) ----
# Where Notes attachments are stored. Blank = .lilin-notes-files in DATA_DIR.
NOTES_FILES_DIR=
# Text in Notes images becomes searchable: Windows OCR on Windows, Tesseract elsewhere. off = disable.
NOTES_OCR=
# Full path to tesseract if it isn't on PATH.
TESSERACT=

# ---- House (owners only) ----
# Shared secret for agents/lilin-house. setup.js generates one.
HOUSE_TOKEN=
# Bearer token the screentime daemons send to POST /api/screentime. setup.js generates one.
SCREENTIME_TOKEN=
# AdGuard Home web UI and login, for protection state and query stats, e.g. http://localhost:3000
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASS=
# Extra Wake-on-LAN broadcast addresses, comma-separated (only if waking a PC doesn't work).
WOL_BROADCAST=
# House > Sharing: your internet upload speed in Mbit/s, so the meter shows how full it is.
UPLOAD_MBPS=
# Hardware encodes the GPU runs at once (GeForce: 8 on current drivers).
NVENC_SESSION_LIMIT=8
# Windows: off = don't sample performance counters and nvidia-smi every 5 s.
LOAD_SAMPLER=
# Full path to nvidia-smi if it isn't on PATH.
NVIDIA_SMI=
# Status file written by tools/torrent-vpn (Windows). Blank = its default location.
TORRENT_VPN_STATUS=

# ---- Clips (owners only) ----
# Folder game clips are synced to (Kept/<game>/, Trimmed Clips/). Blank hides the tab.
CLIPS_DIR=

# ---- Invites (Cloudflare Zero Trust email list; docs/remote-access.md#invites) ----
# API token with "Zero Trust: Edit" (account level).
CF_API_TOKEN=
CF_ACCOUNT_ID=
# ID of the email list (Zero Trust > Reusable components > Lists) your Access policy allows.
CF_ACCESS_LIST_ID=
INVITE_DAYS=7

# ---- Lilin as Cloudflare Access's sign-in (docs/remote-access.md#lilin-as-the-sign-in-for-access-no-email-codes) ----
# With all three set, Access logs people in with their Lilin password and invites sign people straight in.
OIDC_CLIENT_ID=
# A long random string; the same value goes into the Access login method.
OIDC_CLIENT_SECRET=
# https://<team>.cloudflareaccess.com/cdn-cgi/access/callback
OIDC_REDIRECT_URIS=

# ---- Advanced ----
# Signing key for stream links. Blank = generated once and kept in .lilin-secret.
STREAM_SECRET=
