# Copy this file to .env and fill in the values you need.
# Features whose settings are left blank are disabled.

# ---- Server ----
PORT=8080
# LAN address TVs use to reach the server. Detected automatically; set only if detection is wrong.
SERVER_IP=

# ---- Metadata (themoviedb.org > Settings > API) ----
TMDB_TOKEN=
TMDB_LANG=en-US

# ---- Library ----
MEDIA_DIR=C:\Media

# ---- qBittorrent Web UI ----
QBIT_URL=http://localhost:8081
QBIT_USER=admin
QBIT_PASS=
# Remove finished downloads from qBittorrent (files kept) so nothing seeds. Tag a torrent "seed" to keep it.
QBIT_REMOVE_FINISHED=on

# ---- Torrent search ----
TORRENTS=on
TPB_API=https://apibay.org
# Comma-separated; tried in order. Leave blank to use the built-in mirror list.
X1337_URL=
# Optional, for when every 1337x mirror is behind a Cloudflare check.
FLARESOLVERR_URL=

# ---- Subtitles (opensubtitles.com > Profile > API consumers) ----
OPENSUBTITLES_API_KEY=
# Optional. Raises the daily download limit from 5 to 20.
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
SUB_LANGS=en,es,fr,de,it,nl,sv,da,no,fi,pl,pt-pt,pt-br,tr,ar
# Fix the timing of downloaded subtitles automatically (needs ffmpeg).
SUBSYNC=on

# ---- Casting ----
# DLNA description URLs for TVs that aren't discovered automatically, comma-separated.
DLNA_DEVICES=
# Apple TV support requires pyatv (pip install pyatv).
CAST_APPLETV=on
# Full path to atvscript if it isn't on PATH.
ATVSCRIPT=
# Apple TV IP addresses to query directly if discovery fails, comma-separated.
ATV_HOSTS=

# ---- Conversion (requires ffmpeg) ----
CONVERT=on

# Delete originals after conversion. Never applies to files owned by qBittorrent.
CONVERT_DELETE_ORIGINAL=off

# HEVC files added within this many days get an H.264 copy for browsers without HEVC (Firefox)
# right after downloading, so Play starts at once. Older files get one when first played. 0 = off.
BROWSER_H264_DAYS=14

# Full paths, only if ffmpeg/ffprobe aren't on PATH.
FFMPEG=
FFPROBE=

# Where audio-fixed copies of downloaded MP4s are stored. Defaults to ./cache/audio.
AUDIO_FIX_DIR=
# Browser copies made ahead for the next episodes when one needs it (HEVC in Firefox). 0 = off.
PREPARE_NEXT_EPISODES=2

# ---- Activity, House, Clips ----
# Cloudflare Access emails that can see the Activity, House and Clips tabs and the owner's settings
# (auto-delete rules, people). Comma-separated; the first is the owner. Accounts need no setup.
# Leave empty to hide them.
ADMIN_EMAILS=
# Private Notes media storage. Put this on a data drive, e.g. D:\Marquee\Notes.
# Default: .marquee-notes-files beside server.js. Copy existing files before changing it.
NOTES_FILES_DIR=
# Activity city/country: enable "Add visitor location headers" in the domain's Cloudflare
# Rules → Settings → Managed Transforms. No geolocation API key or browser permission is needed.

# Public address for share links / Discord embeds. Defaults to the address the request came in on.
PUBLIC_URL=

# ---- House (server health + home machines) ----
# Shared secret for agents/marquee-house. Generate one with: openssl rand -hex 24
HOUSE_TOKEN=
# Screen Time: token the screentime daemons send (Authorization: Bearer ...) to POST
# /api/screentime; the owner sees it in House → Screen Time. Generate one with: openssl rand -hex 24
SCREENTIME_TOKEN=
# AdGuard Home web UI + login, for protection state and query stats (optional).
ADGUARD_URL=http://localhost:3000
ADGUARD_USER=
ADGUARD_PASS=
# Extra Wake-on-LAN broadcast addresses, comma-separated (only if waking the PC doesn't work).
WOL_BROADCAST=
# House → Sharing: the internet connection's upload in Mbit/s (speed test from the server), so the
# upload meter shows how full it is. Without it the meter shows the rate only.
UPLOAD_MBPS=
# Hardware encodes the GPU runs at once (GeForce: 8 on current drivers).
NVENC_SESSION_LIMIT=8
# off = don't read Windows performance counters and nvidia-smi every 5 s.
LOAD_SAMPLER=

# ---- Clips ----
# Folder the desktop syncs game clips to (Kept/<game>/, Trimmed Clips/). Empty hides the tab.
CLIPS_DIR=

# ---- Invites (Zero Trust email list; see README) ----
# API token with "Zero Trust: Edit" (account level).
CF_API_TOKEN=
CF_ACCOUNT_ID=
# ID of the email list (Zero Trust → Reusable components → Lists) the Marquee policy allows
CF_ACCESS_LIST_ID=
INVITE_DAYS=7
