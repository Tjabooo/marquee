#!/usr/bin/env bash
# lilin-notify TITLE [BODY] [URL]: ask Lilin to send its owner a notification (POST /api/agent/notify).
# For scripts and AI agents on the home machines that need the owner's attention. Reads LILIN_URL and
# HOUSE_TOKEN from ~/.config/lilin-house.env (written by `lilin-house setup`); works only from the home network.
# Lilin allows one every 20 s and 30 a day; the owner can switch them off under Settings › Notifications › Agents.
set -euo pipefail
CONF=${LILIN_HOUSE_CONF:-$HOME/.config/lilin-house.env}
[[ -r $CONF ]] && . "$CONF"
: "${LILIN_URL:?LILIN_URL is not set}" "${HOUSE_TOKEN:?HOUSE_TOKEN is not set}"
[[ $# -ge 1 && -n $1 ]] || { echo "usage: lilin-notify TITLE [BODY] [URL]" >&2; exit 2; }
body=$(jq -n --arg t "$1" --arg b "${2:-}" --arg u "${3:-/}" '{title: $t, body: $b, url: $u}')
curl -sS --max-time 10 -X POST -H "X-Lilin-Token: $HOUSE_TOKEN" -H 'Content-Type: application/json' \
  --data-binary "$body" "${LILIN_URL%/}/api/agent/notify"
echo
