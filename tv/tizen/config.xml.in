<?xml version="1.0" encoding="UTF-8"?>
<!-- Marquee's Samsung TV app. build.sh fills in @SERVER@ (where Marquee runs) and @VERSION@. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://github.com/Tjabooo/marquee/tv" version="@VERSION@" viewmodes="maximized">
  <tizen:application id="MrqTvApp01.Marquee" package="MrqTvApp01" required_version="2.3"/>
  <content src="index.html"/>
  <name>Marquee</name>
  <icon src="icon.png"/>
  <access origin="*" subdomains="true"/>
  <!-- 'unsafe-eval' lets the TV compile the Rust app's WebAssembly (Chrome 69 has no 'wasm-unsafe-eval'). -->
  <tizen:content-security-policy>default-src * data: blob: 'unsafe-inline' 'unsafe-eval'</tizen:content-security-policy>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
