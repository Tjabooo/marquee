<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Installs the app's own updates from the Marquee server (the TV asks once). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Android 12+: once allowed, the app updates itself without asking (only while it isn't on screen). -->
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
  <!-- The update check every few hours carries on after the TV restarts. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-feature android:name="android.software.leanback" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

  <!-- Cleartext: Marquee is usually reached at a plain http:// address on the home network. -->
  <application
    android:label="Marquee"
    android:icon="@mipmap/ic_launcher"
    android:banner="@drawable/banner"
    android:theme="@style/Marquee"
    android:allowBackup="false"
    android:hardwareAccelerated="true"
    android:usesCleartextTraffic="true"
    android:enableOnBackInvokedCallback="true">
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:screenOrientation="landscape"
      android:windowSoftInputMode="adjustPan|stateHidden"
      android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity>
    <provider
      android:name=".ApkProvider"
      android:authorities="app.marquee.tv.update"
      android:exported="false"
      android:grantUriPermissions="true" />
    <service
      android:name=".UpdateJob"
      android:permission="android.permission.BIND_JOB_SERVICE"
      android:exported="false" />
    <receiver
      android:name=".UpdateReceiver"
      android:exported="false" />
  </application>
</manifest>
