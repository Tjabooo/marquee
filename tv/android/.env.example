# Settings for tv/android/build.sh (see docs/android-tv.md). Copy to .env and fill in.
# Where the TV reaches Marquee. Empty: the app asks for the address on its first start.
MARQUEE_URL=http://192.168.1.10:8080
# The Android SDK (platform 36 + build-tools) and a JDK 17–21.
ANDROID_HOME=
JAVA_HOME=
# For --publish: where the server keeps tv/android/dist (scp target), when you build on another machine.
PUBLISH_TO=
# For --install: a TV with network debugging on (adb).
TV=
